{
  "name": "experiment-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check": "npm run lint && npm test && npm run build",
    "test:ui": "node --test tests/mounted-ui.test.ts",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.ts",
    "test:watch": "node --test --watch tests/*.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.87.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.4"
  }
}
